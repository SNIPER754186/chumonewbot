# Funciones de descarga y movimiento de archivos ChumoGH
fun_filez () {
fup="$HOME/update"
echo "$1" >> $HOME/files.log
[[ $1 = 'http-server.py' ]] && mv ${fup}/$1 /bin/http-server.sh && chmod +x /bin/http-server.sh
[[ -e $1 ]] && mv -f ${fup}/$1 /etc/SCRIPT/$1
}

# Funciones de descarga y movimiento de archivos LATAM
fun_filezLTM () {
fup="$HOME/update"
echo "$1" >> $HOME/files.log
#[[ $1 = 'http-server.py' ]] && mv ${fup}/$1 /bin/http-server.sh && chmod +x /bin/http-server.sh # Comentado en el original
[[ -e $1 ]] && mv -f ${fup}/$1 /etc/LTM/$1
}

# Función para actualizar scripts ChumoGH desde el repositorio remoto
atualiza_fun () {
msg -bar
[[ -d $HOME/update ]] && rm -rf $HOME/update/*
[[ ! -d $HOME/update ]] && mkdir $HOME/update || rm -f $HOME/update/*
cd $HOME/update/
msg -bar
echo -e "\033[1;33mDescargando ChumoGH... ESPERE "
msg -bar
# URL del repositorio de scripts ChumoGH (¡ofuscada en el original!)
wget -q --no-check-certificate -O $HOME/files.tar.gz https://github.com/SNIPER754186/chumonewbot/raw/refs/heads/LaTamSRC/SCRIPTS/ADMcgh/SCRIPT.tar.gz
[[ -d $HOME/update ]] && rm -rf $HOME/update/* || mkdir $HOME/update # Esto es redundante si $HOME/update se limpia/crea arriba
[[ -e $HOME/files.tar.gz ]] && tar -xzvf $HOME/files.tar.gz -C $HOME/update &> /dev/null
rm -f $HOME/files.tar.gz
chmod 666 $HOME/update/*
n=1
unset arqs
n=1 # Reset de n
rm -f $HOME/files.log
for arqs in `ls $HOME/update`; do
echo -ne "\033[1;33m FILE \e[32m [${arqs}.CGH.${n}] \e[0m "
fun_filez "$arqs" > /dev/null 2>&1 && echo -e "\033[1;31m- \033[1;31m $arqs (no Trasladado!)" || echo -e "\033[1;31m- \033[1;32m $arqs Trasladado!"
n=$(($n + 1))
done
# Crea el comando 'kcgh' que fuentea un script remoto (¡URL ofuscada!)
echo 'source <(curl -sSL https://raw.githubusercontent.com/SNIPER754186/chumonewbot/refs/heads/LaTamSRC/Gestor/gerar.sh)' > /bin/kcgh && chmod +x /bin/kcgh
# wget -q -O /bin/http-server.sh https://www.dropbox.com/s/st58jec4dit71fx/http-server.py && chmod +x /bin/http-server.sh # Comentado en el original
cd $HOME
[[ -e $HOME/lista ]] && rm $HOME/lista
[[ -d $HOME/update ]] && rm -rf $HOME/update
cd $HOME && rm -rf $HOME/update && rm -f $HOME/files.tar.gz
#ID="$(cat ${FILE2}.name)" && ID="$(echo $ID | awk '{print $1}' | sed -e 's/[^0-9]//ig')" # Esta línea parece incompleta o de un contexto diferente
}

# Función para actualizar scripts LATAM desde el repositorio remoto
atualiza_funLTM () {
msg -bar
[[ -d $HOME/update ]] && rm -rf $HOME/update/* || mkdir $HOME/update
cd $HOME/update/
msg -bar
echo -e "\033[1;33mDescargando LATAM... ESPERE "
msg -bar
# URL del repositorio de scripts LATAM (Dropbox)
wget -q --no-check-certificate -O $HOME/files.tar.gz https://www.dropbox.com/s/z16y8r2pqurbz4t/SCRIPT.tar.gz
[[ -d $HOME/update ]] && rm -rf $HOME/update/* || mkdir $HOME/update # Redundante
[[ -e $HOME/files.tar.gz ]] && tar -xzvf $HOME/files.tar.gz -C $HOME/update &> /dev/null
rm -f $HOME/files.tar.gz
chmod 666 $HOME/update/*
n=1
unset arqs
n=1 # Reset de n
rm -f $HOME/files.log
for arqs in `ls $HOME/update`; do
echo -ne "\033[1;33m FILE \e[32m [${arqs}.LTM.${n}] \e[0m "
fun_filezLTM "$arqs" > /dev/null 2>&1 && echo -e "\033[1;31m- \033[1;31m $arqs (no Trasladado!)" || echo -e "\033[1;31m- \033[1;32m $arqs Trasladado!"
n=$(($n + 1))
done
cd $HOME
[[ -e $HOME/lista ]] && rm $HOME/lista
[[ -d $HOME/update ]] && rm -rf $HOME/update
cd $HOME && rm -rf $HOME/update && rm -f $HOME/files.tar.gz
}

# Llamada a la función principal de verificación
check_ip
unset Key # Variable no usada en este contexto
function_verify "${PAM}"

# Si $PAM no se pasa como argumento, el script se "autodestruye" (según la lógica original)
[[ -z ${PAM} ]] && {
clear&clear && echo " DESTRUYENDO FICHERO rm -rf /bin " && exit
}

echo "$(wget -qO- ifconfig.me)" > /etc/key-gerador
echo -ne "\033[0m" # Resetea colores de la terminal
rm -f setup* # Elimina archivos de setup
rm -f ADm* # Elimina archivos ADm
