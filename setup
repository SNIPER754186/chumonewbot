_hora=$(printf '%(%D-%H:%M:%S)T')
# TOKEN y ID de Telegram HARDCODEADOS - ¡PRECAUCIÓN DE SEGURIDAD!
xyz='1835793685:AAETvw5c4fF4fhUIconDQK5QyjXC-Ub2L74'
ID="$(echo $xyz| awk '{print $2}')" # Esto probablemente no extraiga el ID correctamente del formato dado.
TOKEN="$(echo $xyz| awk '{print $1}')"
urlBOT="https://api.telegram.org/bot$TOKEN/sendMessage"

# Fuente de estilos remota (original del script)
source <(curl -sSL https://raw.githubusercontent.com/ChumoGH/ADMcgh/main/Plugins/system/styles.cpp) > /dev/null

